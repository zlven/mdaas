# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example IS committed, so contributors can see the shape
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Build artefacts — generated by `npm run build:assets` from prompts/ and
# knowledge/. The sources are committed; these are not. docs/02_TECH_SPEC.md §4
# ---------------------------------------------------------------------------
/lib/generated/
/public/knowledge/
/public/pdf/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Pre-existing local Python artefacts. This is not a Python project — these
# were here before the scaffold and are not part of the build.
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Business plan and internal specs. Deliberately NOT published: the repository
# is public. See docs/00_PRODUCT_BRIEF.md §0 for why these are also not
# authoritative for the build.
# ---------------------------------------------------------------------------
/project_plan/
