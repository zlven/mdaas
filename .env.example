# ============================================================
#  环境变量示例
#  复制为 .env.local 后按需修改。
# ============================================================
#
#  ⚠️  重要：这个项目没有服务端，因此这里没有任何密钥。
#
#     用户的 API Key 由用户在浏览器里自己填写，保存在他自己的
#     localStorage 中，直接发往模型服务商。它不经过任何服务端，
#     也不应该出现在任何环境变量里。
#
#     绝不要在这里放 API Key。尤其是 NEXT_PUBLIC_* 开头的变量——
#     它们会被编译进前端产物，任何人打开浏览器都能看到。
#
# ============================================================


# ------------------------------------------------------------
# 应用地址
# ------------------------------------------------------------
# 用于生成分享链接和站点元信息。本地开发不用填。
# NEXT_PUBLIC_APP_URL=https://your-domain.com


# ------------------------------------------------------------
# 可选：转发代理地址
# ------------------------------------------------------------
# 只在国内模型服务商（DeepSeek / Kimi / 豆包等）拒绝浏览器直连
# 时需要。它是一个无状态的转发服务，不保存任何东西。
#
# 部署方式见 docs/05_API_SPEC.md §6。
# 如果只使用 OpenAI / Claude / Gemini，留空即可。
#
# 注意：这个地址不是密钥，会出现在前端产物里，这是正常的。
# NEXT_PUBLIC_PROXY_URL=https://your-worker.workers.dev


# ------------------------------------------------------------
# 可选：知识库构建参数
# ------------------------------------------------------------
# 分块长度上限（中文字符数），默认 500。
# 一般不需要改。详见 docs/02_TECH_SPEC.md §8.2。
# KNOWLEDGE_CHUNK_MAX_CHARS=500


# ------------------------------------------------------------
# 可选：默认模型
# ------------------------------------------------------------
# 这里填的是「首次访问时输入框里的预填值」，不是密钥，
# 也不代表服务端调用任何模型。
#
# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=gpt-4o
